// ---- Input ------------------------------------------------------------------------------------------
void SalonApply() {
    auto pending=SalonPending();if(pending.empty() || SalonBusy())return;
    int64_t price=SalonPendingPrice();
    if(!salon.confirmAt || GetTickCount()-salon.confirmAt>=5000) {
        // First click: say what changes and what it costs; a second click within 5 seconds applies.
        std::wstring what;for(int k:pending){if(!what.empty())what+=L"\x3001";what+=Text(k==0?L"slTabHair":k==1?L"slTabFace":L"slTabSkin")+L"\x300C"+SalonName(k,salon.preview[k])+L"\x300D";}
        salon.confirmAt=GetTickCount();
        SalonStatus(what+L"  "+(price>0?Amount(price)+L" "+Text(L"costColumn"):Text(L"slFree"))+L"  "+Text(L"slConfirm"),Palette::Amber);
        return;
    }
    if(helper.meso<price){SalonStatus(Text(L"slNoMeso"),Palette::Red);return;}
    salon.confirmAt=0;salon.status.clear();
    for(int k:pending)HelperRequest(MapleProtocol::SalonApply,k,salon.preview[k],salon.price[k]);
    SalonDirty();
}
void SalonClick(Window& w,int id) {
    if(id!=SalonSearchBox)salon.searchFocus=false;
    if(id!=SalonSeriesBox && !(id>=SalonSeriesItem && id<SalonSeriesItem+100))salon.seriesOpen=false;
    if(id==1){HideSalon();return;}
    if(id>=100 && id<200){for(auto& bar:w.scrollbars)if(id==bar.id || id==bar.id+1){*bar.value=(std::max)(0,(std::min)(bar.maximum,*bar.value+(id==bar.id?-1:1)));SalonDirty();}return;}
    if(id>=SalonTab && id<SalonTab+3){SalonSwitchTab(id-SalonTab);return;}
    if(id>=SalonFilter && id<SalonFilter+6){salon.filter=id-SalonFilter;salon.offset=0;salon.viewDirty=true;SalonDirty();return;}
    if(id>=SalonColour && id<SalonColour+9){SalonSetColour(id-SalonColour);return;}
    if(id>=SalonCell && id<SalonCell+500){SalonSelect(salon.offset*SalonColumns()+id-SalonCell);return;}
    if(id>=SalonSeriesItem && id<SalonSeriesItem+100) {
        int entry=id-SalonSeriesItem;auto series=SalonSeries();salon.series=entry==0?-1:entry<=int(series.size())?series[entry-1].first:-1;
        salon.seriesOpen=false;salon.offset=0;salon.viewDirty=true;SalonDirty();return;
    }
    switch(id) {
        case SalonSearchBox:salon.searchFocus=true;break;
        case SalonSeriesBox:salon.seriesOpen=!salon.seriesOpen;salon.seriesOffset=0;break;
        case SalonSortButton:salon.sort=1-salon.sort;salon.offset=0;salon.viewDirty=true;break;
        case SalonBigButton:salon.bigCards=!salon.bigCards;salon.offset=0;salon.viewDirty=true;break;
        case SalonReset:for(int& p:salon.preview)p=0;salon.confirmAt=0;for(int k=0;k<3;++k)SalonTry(k);break;
        case SalonTryButton:
            // Start from what is worn so only real differences are sent.
            if(salon.tryOn)SalonEndTry();else{salon.tryOn=true;for(int k=0;k<3;++k){salon.tried[k]=salon.current[k];SalonTry(k);}}
            break;
        case SalonUndoButton:if(salon.undo[salon.tab] && !SalonBusy())HelperRequest(MapleProtocol::SalonUndo,salon.tab);break;
        case SalonFavoriteButton: {
            int style=salon.selected[salon.tab];if(!style || SalonBusy())break;
            HelperRequest(MapleProtocol::SalonFavorite,salon.tab,style,salon.favorites[salon.tab].count(style)?0:1);break;
        }
        case SalonApplyButton:SalonApply();return;
        default:break;
    }
    SalonDirty();
}
// Arrows move the selection (and the preview), Page/Home/End jump, digits pick a colour; while the
// search box has focus digits and Backspace edit it instead.
bool SalonKey(unsigned key) {
    int digit=key>='0' && key<='9'?int(key-'0'):key>=VK_NUMPAD0 && key<=VK_NUMPAD9?int(key-VK_NUMPAD0):-1;
    if(salon.searchFocus) {
        if(digit>=0 && salon.search.size()<9)salon.search+=wchar_t(L'0'+digit);
        else if(key==VK_BACK && !salon.search.empty())salon.search.pop_back();
        else if(key==VK_RETURN || key==VK_ESCAPE)salon.searchFocus=false;
        else return false;
        salon.offset=0;salon.viewDirty=true;SalonDirty();return true;
    }
    if(key==VK_ESCAPE && salon.seriesOpen){salon.seriesOpen=false;SalonDirty();return true;}
    if(digit>=1 && digit<=9){SalonSetColour(digit-1);return true;}
    if(salon.viewDirty)SalonRebuild();
    int index=SalonSelectedIndex(),cols=SalonColumns(),page=SalonVisibleRows()*cols,last=int(salon.view.size())-1;
    if(last<0)return false;
    int next=index;
    switch(key) {
        case VK_LEFT:next=index<0?0:index-1;break;
        case VK_RIGHT:next=index<0?0:index+1;break;
        case VK_UP:next=index<0?0:index-cols;break;
        case VK_DOWN:next=index<0?0:index+cols;break;
        case VK_PRIOR:next=index<0?0:index-page;break;
        case VK_NEXT:next=index<0?0:index+page;break;
        case VK_HOME:next=0;break;
        case VK_END:next=last;break;
        default:return false;
    }
    SalonSelect((std::max)(0,(std::min)(last,next)));return true;
}
void SalonWheel(int delta) {
    if(salon.seriesOpen){salon.seriesOffset=(std::max)(0,salon.seriesOffset+(delta>0?-1:1));SalonDirty();return;}
    salon.offset=(std::max)(0,(std::min)(SalonMaxOffset(),salon.offset+(delta>0?-1:1)));SalonDirty();
}
void SalonUpdate() {
    if(!InField()){HideSalon();return;}
    DWORD now=GetTickCount();HelperFlush(now);HelperExpire(now);
    // A catalogue page that never came back is asked for again.
    int k=salon.tab;if(salon.asked[k] && now-salon.asked[k]>10000){salon.asked[k]=0;SalonRequestNext(k);}
    if(salon.searchFocus || (salon.confirmAt && now-salon.confirmAt<6000))SalonDirty(); // caret and the confirm window
}
