// Native salon (Zaoxing Wu): browse, preview and change hair, face and skin. Opened from the Maple Helper hub.
// Included by QuestHelperUI.cpp after MapleHelperUI.inl; it reuses the native window, skins, text helpers
// and the Maple Helper request queue. The server (MapleHelperUiHandler) owns the catalogue, prices,
// favourites and every change; this view composes avatars from WZ bitmaps and SalonLayout.txt.

constexpr int SalonPanelLeft=8,SalonPanelRight=204,SalonGridLeft=214,SalonGridTop=176,SalonGridBottom=376,SalonBar=426,SalonBodyBottom=416;
enum SalonButton {SalonTab=4000,SalonFilter=4010,SalonColour=4020,SalonCell=4100,SalonSeriesItem=4600,
    SalonSearchBox=4030,SalonSeriesBox=4031,SalonSortButton=4032,SalonBigButton=4033,SalonCompare=4034,SalonReset=4035,
    SalonTryButton=4036,SalonUndoButton=4037,SalonFavoriteButton=4038,SalonApplyButton=4039};
enum SalonFilterKind {FilterAll=0,FilterMale=1,FilterFemale=2,FilterUnisex=3,FilterFavorite=4,FilterRecent=5};

struct SalonStyle {int id=0,gender=0,colours=0,first=0;std::wstring name;};
struct SalonLayer {std::wstring path;int z=5,ox=0,oy=0;std::vector<std::pair<std::wstring,POINT>> anchors;};
struct SalonState {
    bool layoutLoaded=false,layoutOk=false;
    std::map<int,std::vector<SalonLayer>> bodies,styles[2],overrides[2];
    std::vector<SalonStyle> catalog[3];int total[3]={-1,-1,-1};DWORD asked[3]={0,0,0};
    int tab=0,filter=FilterAll,series=-1,sort=0,offset=0,seriesOffset=0;bool bigCards=false,seriesOpen=false;
    std::wstring search;bool searchFocus=false;
    std::vector<int> view;bool viewDirty=true;
    int selected[3]={0,0,0},colour[3]={0,0,0},preview[3]={0,0,0},current[3]={0,0,0};
    std::set<int> favorites[3];int favoriteLimit=0;int64_t price[3]={0,0,0};bool undo[3]={false,false,false};bool stateLoaded=false;
    std::deque<int> recent[3];
    bool tryOn=false;int tried[3]={0,0,0};
    DWORD confirmAt=0;
    std::wstring status;COLORREF statusColor=Palette::Muted;
    std::map<uint64_t,std::unique_ptr<Bitmap>> thumbs;
};
SalonState salon;
// Only the salon's own changes block its buttons; background catalogue pages do not.
bool SalonBusy() {
    for(const auto& p:helper.pending){int a=p.second.first;if(a==MapleProtocol::SalonApply || a==MapleProtocol::SalonFavorite || a==MapleProtocol::SalonUndo || a==MapleProtocol::SalonState)return true;}
    return false;
}
void SalonDirty(){if(salonWindow.shown)Invalidate(salonWindow);}
void SalonStatus(const std::wstring& text,COLORREF color){salon.status=text;salon.statusColor=color;SalonDirty();}

// ---- Layout table ------------------------------------------------------------------------
int SalonZ(const std::wstring& z) {
    static const wchar_t* order[]={L"hairBelowBody",L"body",L"arm",L"head",L"face",L"hairShade",L"hair",L"hairOverHead"};
    for(int i=0;i<8;++i)if(z==order[i])return i;
    return 5;
}
std::vector<SalonLayer> ParseLayers(const std::wstring& text) {
    std::vector<SalonLayer> layers;size_t start=0;
    while(start<=text.size()) {
        size_t end=text.find(L';',start);if(end==std::wstring::npos)end=text.size();
        std::vector<std::wstring> f;size_t a=start;
        while(a<=end){size_t b=text.find(L',',a);if(b==std::wstring::npos || b>end)b=end;f.push_back(text.substr(a,b-a));a=b+1;}
        if(f.size()>=4) {
            SalonLayer l;l.path=f[0];l.z=SalonZ(f[1]);l.ox=_wtoi(f[2].c_str());l.oy=_wtoi(f[3].c_str());
            for(size_t i=4;i+2<f.size();i+=3)l.anchors.push_back({f[i],POINT{_wtoi(f[i+1].c_str()),_wtoi(f[i+2].c_str())}});
            layers.push_back(std::move(l));
        }
        start=end+1;
    }
    return layers;
}
// SalonLayout.txt lives next to QuestHelperUI.ini (generated by tools/export-salon-layout.ps1).
bool LoadSalonLayout() {
    if(salon.layoutLoaded)return salon.layoutOk;
    salon.layoutLoaded=true;
    auto path=labelFile.substr(0,labelFile.find_last_of(L"\\/")+1)+L"SalonLayout.txt";
    FILE* file=_wfopen(path.c_str(),L"rb");if(!file)return false;
    std::string bytes;char buffer[65536];size_t n;while((n=fread(buffer,1,sizeof(buffer),file))>0)bytes.append(buffer,n);fclose(file);
    int wide=MultiByteToWideChar(CP_UTF8,0,bytes.data(),int(bytes.size()),nullptr,0);std::wstring text(wide,L'\0');
    MultiByteToWideChar(CP_UTF8,0,bytes.data(),int(bytes.size()),text.data(),wide);
    size_t start=0;
    while(start<text.size()) {
        size_t end=text.find(L'\n',start);if(end==std::wstring::npos)end=text.size();
        std::wstring line=text.substr(start,end-start);if(!line.empty() && line.back()==L'\r')line.pop_back();start=end+1;
        size_t s1=line.find(L' ');if(s1==std::wstring::npos)continue;size_t s2=line.find(L' ',s1+1);if(s2==std::wstring::npos)continue;
        std::wstring tag=line.substr(0,s1);int id=_wtoi(line.substr(s1+1,s2-s1-1).c_str());auto layers=ParseLayers(line.substr(s2+1));
        if(tag==L"B")salon.bodies[id]=std::move(layers);
        else if(tag==L"H")salon.styles[0][id]=std::move(layers);
        else if(tag==L"H!")salon.overrides[0][id]=std::move(layers);
        else if(tag==L"F")salon.styles[1][id]=std::move(layers);
        else if(tag==L"F!")salon.overrides[1][id]=std::move(layers);
    }
    salon.layoutOk=!salon.bodies.empty();
    return salon.layoutOk;
}
int SalonColourOf(int kind,int id){if(kind==0)return id%10<=7?id%10:-1;if(kind==1)return id/100%10<=8?id/100%10:-1;return -1;}
int SalonStyleOf(int kind,int id){int c=SalonColourOf(kind,id);if(c<0)return id;return kind==0?id-c:id-c*100;}
int SalonVariant(int kind,const SalonStyle& s,int colour) {
    if(kind==2)return s.id;
    if(!(s.colours>>colour&1))return s.first;
    return kind==0?s.id+colour:s.id+colour*100;
}

// ---- Avatar composition ---------------------------------------------------------------------
// Straight-alpha "over" into a transparent buffer (Put keeps the destination alpha, which is wrong here).
void BlendOver(Bitmap& d,int x,int y,Bitmap* s) {
    if(!s || !s->pixels || !d.pixels)return;GdiFlush();bool alpha=HasAlpha(*s);
    for(int j=0;j<s->height;++j){int ty=y+j;if(ty<0 || ty>=d.height)continue;
        for(int i=0;i<s->width;++i){int tx=x+i;if(tx<0 || tx>=d.width)continue;
            DWORD p=s->pixels[j*s->width+i];unsigned sa=alpha?p>>24:255;if(!sa)continue;
            DWORD& q=d.pixels[ty*d.width+tx];unsigned da=q>>24;
            if(sa==255 || !da){q=(sa<<24)|(p&0xFFFFFF);continue;}
            unsigned oa=sa+da*(255-sa)/255;DWORD o=oa<<24;
            for(int shift:{0,8,16}){unsigned sc=(p>>shift)&255,dc=(q>>shift)&255;o|=((sc*sa+dc*da*(255-sa)/255)/oa)<<shift;}
            q=o;
        }}
}
std::wstring SalonLayerPath(int kind,int id,const SalonLayer& l) {
    if(!l.path.empty() && l.path[0]==L'/')return L"Character"+l.path;
    return std::wstring(L"Character/")+(kind==0?L"Hair/":L"Face/")+Padded(id,8)+L".img/"+l.path;
}
const std::vector<SalonLayer>* SalonLayers(int kind,int id) {
    auto o=salon.overrides[kind].find(id);if(o!=salon.overrides[kind].end())return &o->second;
    auto s=salon.styles[kind].find(SalonStyleOf(kind,id));return s==salon.styles[kind].end()?nullptr:&s->second;
}
// Places every layer so that one of its anchors meets the same anchor of a layer already placed
// (navel for the body, brow for a bare head), the way the client builds avatars.
std::unique_ptr<Bitmap> ComposeAvatar(int skin,int hair,int face,bool body) {
    if(!LoadSalonLayout())return nullptr;
    struct Item{const SalonLayer* layer;std::wstring path;Bitmap* bitmap;int left,top;};
    std::vector<Item> items;
    auto bodyLayers=salon.bodies.find(skin);if(bodyLayers==salon.bodies.end())bodyLayers=salon.bodies.find(0);
    if(bodyLayers==salon.bodies.end())return nullptr;
    for(const auto& l:bodyLayers->second){if(!body && l.z!=SalonZ(L"head"))continue;items.push_back({&l,L"Character"+l.path,nullptr,0,0});}
    for(int kind=0;kind<2;++kind){int id=kind==0?hair:face;if(auto layers=SalonLayers(kind,id))for(const auto& l:*layers)items.push_back({&l,SalonLayerPath(kind,id,l),nullptr,0,0});}
    std::map<std::wstring,POINT> anchors;anchors[body?L"navel":L"brow"]={0,0};
    std::vector<bool> placed(items.size(),false);
    for(bool progress=true;progress;) {
        progress=false;
        for(size_t i=0;i<items.size();++i) {
            if(placed[i])continue;const auto& l=*items[i].layer;
            const std::pair<std::wstring,POINT>* hit=nullptr;
            for(const auto& a:l.anchors)if(anchors.count(a.first)){hit=&a;break;}
            if(!hit)continue;
            POINT at=anchors[hit->first];items[i].left=at.x-hit->second.x-l.ox;items[i].top=at.y-hit->second.y-l.oy;
            for(const auto& a:l.anchors)anchors.emplace(a.first,POINT{items[i].left+l.ox+a.second.x,items[i].top+l.oy+a.second.y});
            placed[i]=true;progress=true;
        }
    }
    int x0=0x7FFF,y0=0x7FFF,x1=-0x7FFF,y1=-0x7FFF;
    for(size_t i=0;i<items.size();++i) {
        if(!placed[i])continue;items[i].bitmap=Skin(items[i].path);auto b=items[i].bitmap;if(!b)continue;
        x0=(std::min)(x0,items[i].left);y0=(std::min)(y0,items[i].top);x1=(std::max)(x1,items[i].left+b->width);y1=(std::max)(y1,items[i].top+b->height);
    }
    if(x1<=x0 || y1<=y0)return nullptr;
    auto out=std::make_unique<Bitmap>(x1-x0,y1-y0);if(!out->pixels)return nullptr;
    GdiFlush();std::fill(out->pixels,out->pixels+out->width*out->height,0);out->alphaMode=1;
    std::vector<size_t> order;for(size_t i=0;i<items.size();++i)if(placed[i] && items[i].bitmap)order.push_back(i);
    std::stable_sort(order.begin(),order.end(),[&](size_t a,size_t b){return items[a].layer->z<items[b].layer->z;});
    for(size_t i:order)BlendOver(*out,items[i].left-x0,items[i].top-y0,items[i].bitmap);
    return out;
}
Bitmap* CachedAvatar(int skin,int hair,int face,bool body) {
    uint64_t key=(uint64_t(body)<<62)|(uint64_t(skin&0xFF)<<48)|(uint64_t(hair&0xFFFFFF)<<24)|uint64_t(face&0xFFFFFF);
    auto it=salon.thumbs.find(key);if(it!=salon.thumbs.end())return it->second.get();
    if(salon.thumbs.size()>600)salon.thumbs.clear(); // bounded: a scroll through every style never grows without limit
    return salon.thumbs.emplace(key,ComposeAvatar(skin,hair,face,body)).first->second.get();
}
// The look shown in the preview: what is being previewed, else what is worn.
int SalonShown(int kind){return salon.preview[kind]?salon.preview[kind]:salon.current[kind];}

// ---- Catalogue view ----------------------------------------------------------------------------
const SalonStyle* SalonFind(int kind,int style){for(const auto& s:salon.catalog[kind])if(s.id==style)return &s;return nullptr;}
std::wstring SalonName(int kind,int id){auto s=SalonFind(kind,kind==2?id:SalonStyleOf(kind,id));return s?s->name:std::to_wstring(id);}
int SalonColumns(){return salon.bigCards?4:6;}
int SalonRowHeight(){return salon.bigCards?66:50;}
int SalonVisibleRows(){return (SalonGridBottom-SalonGridTop)/SalonRowHeight();}
void SalonRebuild() {
    auto& v=salon.view;v.clear();const auto& c=salon.catalog[salon.tab];
    auto keep=[&](const SalonStyle& s){
        if(salon.filter==FilterMale && s.gender!=0)return false;
        if(salon.filter==FilterFemale && s.gender!=1)return false;
        if(salon.filter==FilterUnisex && s.gender!=2)return false;
        if(salon.filter==FilterFavorite && !salon.favorites[salon.tab].count(s.id))return false;
        if(salon.series>=0 && s.id/1000!=salon.series)return false;
        if(!salon.search.empty()) {
            // Ids only: the native box has no IME. A style matches its own id or any colour's id.
            if(std::to_wstring(s.id).find(salon.search)==std::wstring::npos) {
                int typed=_wtoi(salon.search.c_str());
                if(!(salon.search.size()>=5 && salon.tab<2 && SalonStyleOf(salon.tab,typed)==s.id))return false;
            }
        }
        return true;
    };
    if(salon.filter==FilterRecent) {
        for(int id:salon.recent[salon.tab])for(int i=0;i<int(c.size());++i)if(c[i].id==id && keep(c[i]))v.push_back(i);
    } else {
        for(int i=0;i<int(c.size());++i)if(keep(c[i]))v.push_back(i);
        if(salon.sort==1)std::reverse(v.begin(),v.end()); // newest = highest ids first
    }
    int rows=(int(v.size())+SalonColumns()-1)/SalonColumns();
    salon.offset=(std::max)(0,(std::min)(salon.offset,rows-SalonVisibleRows()));
    salon.viewDirty=false;
}
int SalonMaxOffset(){int rows=(int(salon.view.size())+SalonColumns()-1)/SalonColumns();return (std::max)(0,rows-SalonVisibleRows());}
// Hair and face series: the thousand block of the id (30000, 31000, ...), as the catalogue was ported.
std::vector<std::pair<int,int>> SalonSeries() {
    std::map<int,int> counts;for(const auto& s:salon.catalog[salon.tab])++counts[s.id/1000];
    return std::vector<std::pair<int,int>>(counts.begin(),counts.end());
}
void SalonRequestNext(int kind) {
    if(salon.total[kind]>=0 && int(salon.catalog[kind].size())>=salon.total[kind])return;
    int page=int(salon.catalog[kind].size())/200;
    HelperRequest(MapleProtocol::SalonCatalog,kind,page);salon.asked[kind]=GetTickCount();
}
void SalonOnCatalog(const MapleProtocol::Snapshot& s) {
    int kind=s.value;if(kind<0 || kind>2)return;
    salon.total[kind]=s.extra;
    int before=int(salon.catalog[kind].size());
    for(const auto& r:s.rows) {
        // Pages arrive in order; a repeated page (retry) never duplicates styles.
        if(r.max*200<before)continue;
        salon.catalog[kind].push_back({r.id,r.kind,r.min,r.icon,r.label});
    }
    salon.asked[kind]=0;
    if(int(salon.catalog[kind].size())<salon.total[kind])SalonRequestNext(kind);
    // Then fetch the other tabs in the background, so names show everywhere (header, summary).
    else for(int k=0;k<3;++k)if(salon.total[k]<0 && !salon.asked[k]){SalonRequestNext(k);break;}
    if(kind==salon.tab)salon.viewDirty=true;
    SalonDirty();
}
void SalonOnState(const MapleProtocol::Snapshot& s) {
    salon.current[0]=s.value;salon.current[1]=s.extra;
    for(auto& f:salon.favorites)f.clear();for(bool& u:salon.undo)u=false;
    for(const auto& r:s.rows) {
        if(r.kind>=0 && r.kind<=2)salon.favorites[r.kind].insert(r.id);
        else if(r.kind==MapleProtocol::SalonCurrentSkin)salon.current[2]=r.id;
        else if(r.kind==MapleProtocol::SalonPrice && r.id>=0 && r.id<=2)salon.price[r.id]=r.cost;
        else if(r.kind==MapleProtocol::SalonUndoable && r.id>=0 && r.id<=2)salon.undo[r.id]=true;
        else if(r.kind==MapleProtocol::SalonLimit)salon.favoriteLimit=r.id;
    }
    // A change the server accepted is now the real look: stop previewing it.
    for(int k=0;k<3;++k)if(salon.preview[k]==salon.current[k])salon.preview[k]=0;
    salon.stateLoaded=true;
    if(!s.message.empty())SalonStatus(s.message,Palette::Green);
    if(salon.filter==FilterFavorite)salon.viewDirty=true;
    SalonDirty();
}
void SalonOnError(const std::wstring& message){SalonStatus(message,Palette::Red);}

// ---- Selection and preview ---------------------------------------------------------------------
void SalonTry(int kind) {
    if(!salon.tryOn)return;int id=SalonShown(kind);
    if(salon.tried[kind]==id)return;salon.tried[kind]=id;
    HelperRequest(MapleProtocol::SalonTry,kind,id==salon.current[kind]?0:id);
}
void SalonEndTry() {
    for(int k=0;k<3;++k)if(salon.tried[k] && salon.tried[k]!=salon.current[k])HelperRequest(MapleProtocol::SalonTry,k,0);
    for(int& t:salon.tried)t=0;salon.tryOn=false;
}
void SalonRemember(int kind,int style) {
    auto& r=salon.recent[kind];r.erase(std::remove(r.begin(),r.end(),style),r.end());r.push_front(style);if(r.size()>20)r.pop_back();
}
void SalonSelect(int index) {
    if(index<0 || index>=int(salon.view.size()))return;
    int kind=salon.tab;const auto& s=salon.catalog[kind][salon.view[index]];
    salon.selected[kind]=s.id;
    if(kind<2 && s.colours && !(s.colours>>salon.colour[kind]&1)){for(int c=0;c<9;++c)if(s.colours>>c&1){salon.colour[kind]=c;break;}}
    salon.preview[kind]=SalonVariant(kind,s,salon.colour[kind]);
    salon.confirmAt=0;SalonRemember(kind,s.id);SalonTry(kind);
    // Keep the selection on screen.
    int row=index/SalonColumns();
    if(row<salon.offset)salon.offset=row;else if(row>=salon.offset+SalonVisibleRows())salon.offset=row-SalonVisibleRows()+1;
    SalonDirty();
}
int SalonSelectedIndex(){for(int i=0;i<int(salon.view.size());++i)if(salon.catalog[salon.tab][salon.view[i]].id==salon.selected[salon.tab])return i;return -1;}
void SalonSetColour(int colour) {
    int kind=salon.tab;if(kind>1)return;auto s=SalonFind(kind,salon.selected[kind]?salon.selected[kind]:SalonStyleOf(kind,SalonShown(kind)));
    if(!s || !(s->colours>>colour&1))return;
    salon.colour[kind]=colour;salon.selected[kind]=s->id;salon.preview[kind]=SalonVariant(kind,*s,colour);salon.confirmAt=0;SalonTry(kind);SalonDirty();
}
void OpenSalon() {
    if(!helper.enabled || !InField())return;
    HideHelper();salon.status.clear();salon.confirmAt=0;salon.seriesOpen=false;salon.searchFocus=false;
    for(int k=0;k<3;++k){salon.preview[k]=0;salon.selected[k]=0;}
    salon.stateLoaded=false;LoadSalonLayout();
    Show(salonWindow);HelperRequest(MapleProtocol::SalonState);
    for(int k=0;k<3;++k)if(salon.catalog[k].empty() || int(salon.catalog[k].size())<salon.total[k]){salon.catalog[k].clear();salon.total[k]=-1;}
    SalonRequestNext(salon.tab);salon.viewDirty=true;SalonDirty();
}
void HideSalon(){if(salonWindow.shown)SalonEndTry();Hide(salonWindow);}
void SalonSwitchTab(int tab) {
    if(tab==salon.tab || tab<0 || tab>2)return;
    salon.tab=tab;salon.offset=0;salon.series=-1;salon.seriesOpen=false;salon.search.clear();salon.searchFocus=false;salon.confirmAt=0;
    if(salon.catalog[tab].empty())SalonRequestNext(tab);
    salon.viewDirty=true;SalonDirty();
}

// ---- Drawing --------------------------------------------------------------------------------------
const COLORREF HairSwatch[8]={RGB(40,40,40),RGB(200,60,50),RGB(230,140,40),RGB(230,210,70),RGB(80,160,70),RGB(60,110,210),RGB(140,80,180),RGB(130,90,50)};
const COLORREF EyeSwatch[9]={RGB(40,40,40),RGB(60,110,210),RGB(200,60,50),RGB(80,160,70),RGB(130,90,50),RGB(40,90,170),RGB(140,80,180),RGB(190,150,220),RGB(235,235,235)};
void Disc(HDC dc,RECT r,COLORREF fill,COLORREF edge) {
    HBRUSH brush=CreateSolidBrush(fill);HPEN pen=CreatePen(PS_SOLID,1,edge);auto ob=SelectObject(dc,brush);auto op=SelectObject(dc,pen);
    Ellipse(dc,r.left,r.top,r.right,r.bottom);SelectObject(dc,ob);SelectObject(dc,op);DeleteObject(brush);DeleteObject(pen);
}
void Ring(HDC dc,RECT r,COLORREF edge) {
    HPEN pen=CreatePen(PS_SOLID,2,edge);auto op=SelectObject(dc,pen);auto ob=SelectObject(dc,GetStockObject(NULL_BRUSH));
    Ellipse(dc,r.left,r.top,r.right,r.bottom);SelectObject(dc,ob);SelectObject(dc,op);DeleteObject(pen);
}
// A flat chip used by the filters and toggles; registered as a button.
void Chip(Window& w,HDC dc,int id,RECT r,const std::wstring& text,bool on) {
    bool hover=w.hover==id;
    if(on || hover)SelectionBox(dc,r);
    else{Fill(dc,r,RGB(246,248,251));HBRUSH e=CreateSolidBrush(RGB(221,229,238));FrameRect(dc,&r,e);DeleteObject(e);}
    Write(dc,{r.left,r.top,r.right,r.bottom},text,on?Palette::Blue:Palette::Ink,on,DT_CENTER|DT_SINGLELINE|DT_VCENTER|DT_NOPREFIX);
    w.buttons.push_back({r,id,text,true});
}
void Combo(Window& w,HDC dc,int id,RECT r,const std::wstring& text) {
    Fill(dc,r,RGB(255,255,255));HBRUSH e=CreateSolidBrush(w.hover==id?Palette::SelectEdge:Palette::StripEdge);FrameRect(dc,&r,e);DeleteObject(e);
    Write(dc,{r.left+4,r.top,r.right-14,r.bottom},text,Palette::Ink);
    POINT tri[3]={{r.right-11,r.top+6},{r.right-4,r.top+6},{r.right-8,r.top+10}};
    HBRUSH b=CreateSolidBrush(Palette::Muted);auto ob=SelectObject(dc,b);auto op=SelectObject(dc,GetStockObject(NULL_PEN));Polygon(dc,tri,3);SelectObject(dc,ob);SelectObject(dc,op);DeleteObject(b);
    w.buttons.push_back({r,id,text,true});
}
void Star(HDC dc,int cx,int cy,bool filled) {
    POINT p[10];for(int k=0;k<10;++k){double r=k%2?2.6:6.0,a=-1.5707963+k*0.6283185;p[k]={LONG(cx+r*cos(a)+0.5),LONG(cy+r*sin(a)+0.5)};}
    HBRUSH b=CreateSolidBrush(RGB(255,196,40));HPEN pen=CreatePen(PS_SOLID,1,filled?RGB(190,120,0):Palette::Faint);
    auto ob=SelectObject(dc,filled?(HGDIOBJ)b:GetStockObject(NULL_BRUSH));auto op=SelectObject(dc,pen);Polygon(dc,p,10);
