    if(hoverIndex>=0 && hoverIndex<int(salon.view.size())){const auto& s=salon.catalog[salon.tab][salon.view[hoverIndex]];shown[salon.tab]=SalonVariant(salon.tab,s,salon.colour[salon.tab]);}
